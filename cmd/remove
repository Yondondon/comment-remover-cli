package cmd

import (
	"bytes"
	"fmt"
	"go/scanner"
	"go/token"
	"log"
	"os"
	"path/filepath"
	"sync"

	"github.com/spf13/cobra"
)

type Comment struct {
	Start int
	End   int
}

var Path string

var removeCmd = &cobra.Command{
	Use:   "remove",
	Short: "removes comments from .go files",
	Long:  `remove long`,
	Args:  cobra.NoArgs,
	RunE:  removeComments,
}

func init() {
	rootCmd.AddCommand(removeCmd)

	removeCmd.Flags().BoolP("recursive", "r", false, "recursively checks files in subdirectories")
	removeCmd.Flags().StringVarP(&Path, "path", "p", "", "(required) path to file or directory")
	removeCmd.MarkFlagRequired("path")
}

func readFile(path string) []byte {
	src, err := os.ReadFile(path)
	if err != nil {
		log.Fatal(err)
		os.Exit(1)
	}

	return src
}

func writeFile(path string, src []byte) {
	err := os.WriteFile(path, src, 0666)
	if err != nil {
		log.Fatal(err)
		os.Exit(1)
	}
}

func scanComments(src []byte) []Comment {
	fset := token.NewFileSet()
	file := fset.AddFile("", fset.Base(), len(src))

	var s scanner.Scanner
	s.Init(file, src, nil, scanner.ScanComments)

	var comments []Comment

	for {
		pos, tok, lit := s.Scan()
		if tok == token.EOF {
			break
		}

		if tok == token.COMMENT {
			start := file.Offset(pos)
			comments = append(comments, Comment{
				Start: start,
				End:   start + len(lit),
			})
		}
	}

	return comments
}

func removeComments(cmd *cobra.Command, args []string) error {
	path, err := cmd.Flags().GetString("path")
	if err != nil {
		return err
	}

	isRecursive, err := cmd.Flags().GetBool("recursive")
	if err != nil {
		return err
	}

	var wg sync.WaitGroup

	fmt.Println("Processing...")
	switch pathType := determinePathType(path); pathType {
	case "file":
		processFile(path)
	case "directory":
		wg.Add(1)
		go func() {
			defer wg.Done()
			processDirectory(path, isRecursive, &wg)
		}()

		wg.Wait()
	}
	fmt.Println("All comments have been removed.")
	return nil
}

func determinePathType(path string) string {
	info, err := os.Stat(path)
	if err != nil {
		log.Fatal(err)
		os.Exit(1)
	}

	if info.IsDir() {
		return "directory"
	} else {
		return "file"
	}
}

func processFile(path string) {
	src := readFile(path)
	comments := scanComments(src)

	var result bytes.Buffer
	cursor := 0

	for _, c := range comments {
		lineStart := bytes.LastIndexByte(src[:c.Start], '\n') + 1
		prefix := src[lineStart:c.Start]
		isWholeLine := len(bytes.TrimSpace(prefix)) == 0

		if isWholeLine {
			result.Write(src[cursor:lineStart])

			cursor = c.End
			for cursor < len(src) &&
				(src[cursor] == ' ' || src[cursor] == '\t' || src[cursor] == '\r') {
				cursor++
			}
			if cursor < len(src) && src[cursor] == '\n' {
				cursor++
			}
		} else {
			result.Write(src[cursor:c.Start])
			cursor = c.End
		}
	}

	result.Write(src[cursor:])
	writeFile(path, result.Bytes())
}

func processDirectory(path string, isRecursive bool, wg *sync.WaitGroup) {
	entries, err := os.ReadDir(path)
	if err != nil {
		log.Printf("failed to read directory %s: %v", path, err)
		return
	}

	for _, entry := range entries {
		fullPath := filepath.Join(path, entry.Name())
		if entry.IsDir() && isRecursive {
			wg.Add(1)
			go func() {
				defer wg.Done()
				processDirectory(fullPath, isRecursive, wg)
			}()
		} else if filepath.Ext(fullPath) == ".go" {
			wg.Add(1)

			go func() {
				defer wg.Done()
				processFile(fullPath)
			}()
		}
	}
}
